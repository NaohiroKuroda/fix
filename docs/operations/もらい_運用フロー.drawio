                <mxCell id="B8" value="&lt;b&gt;⑧ 内部処理&lt;/b&gt;&lt;div&gt;&lt;b&gt;発注書に対して受注を承諾する&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fontColor=#333333;" parent="laneB" vertex="1">
                    <mxGeometry x="418" y="1320" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="B9" value="&lt;b&gt;【請求】 発注書確認画面に「承諾日」が入る&lt;/b&gt;&lt;br&gt;【システム】新Fix&lt;br&gt;・承諾日に日付が入った状態になる&lt;br&gt;&lt;div&gt;&lt;b&gt;⭐️発注書ボタン押下時に表示される画面を新規作成&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneB" vertex="1">
