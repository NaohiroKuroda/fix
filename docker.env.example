# new_felix_total 社内サーバー用 環境変数
# このファイルを docker.env にコピーして各値を記入してください。
#   cp docker.env.example docker.env
# ※ docker.env は機密を含むため Git にコミットしないこと。

# ★必須: 実際にアクセスするURL（アセットURL生成に使用。ポートも含める）
APP_URL=http://192.168.10.180:8090

# ★推奨: 自前のアプリキーに変更
#   docker run --rm new-felix-total:latest php artisan key:generate --show
APP_KEY=base64:6Tp4FxaoPVYxd6hg+OT++z47uIKLc7V0OE+exVwwCpE=

# ヘッダー右に表示するユーザー名（任意。未設定なら「管理者」）
DISPLAY_USER_NAME=管理者

# felix_total のベースURL。見積依頼画面の見積先リンク（業者マイページ）生成に使う。
# 見積先リンクは {FELIX_TOTAL_URL}/admin/estimates-custom-detail/auto_login?estimate_unit_company_id={見積先ID}
# となり、felix_total 側の auto_login が cross_auth→業者ログイン→業者編集ページ へ繋ぐ。
# ★ cross_auth クッキー送信のため、ログイン中の felix_total と同じ親ドメインのホストにすること。
#   サーバ（社内）: http://fix.felix-japan.local:8080
#   本番（公開）  : https://fix.felix-japan.co.jp
FELIX_TOTAL_URL=http://fix.felix-japan.local:8080
# ★ サーバ間 HTTP（見積依頼送信 order_estimate）用のベースURL。コンテナから felix_total へ到達できるホスト。
#   FELIX_TOTAL_URL（ブラウザ向け .local）はコンテナから到達できないため分ける。未設定なら FELIX_TOTAL_URL を使用。
#   例（コンテナ→ホスト公開の felix_total）: http://host.docker.internal:8080
FELIX_TOTAL_INTERNAL_URL=http://host.docker.internal:8080
# URL 全体を直接指定したい場合のみ（{id}=見積先ID）。設定すると FELIX_TOTAL_URL より優先。
#FELIX_ESTIMATE_EDIT_URL=

# 既存 fix_db への接続情報（felix_total の .env と同じ値にする）
DB_DATABASE=fix
DB_USERNAME=root
# root のパスワード（felix_total .env の MYSQL_ROOT_PASSWORD と同じ。空ならそのまま空）
DB_PASSWORD=root
