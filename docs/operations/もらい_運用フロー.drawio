                <mxCell id="title" value="もらい（請求先）運用フロー　― 現行Fix / 新Fix / 業者マイページ ―" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="-332" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="pre" value="&lt;b&gt;【前提】&lt;/b&gt;　もらいレコードを作成する時点で、&lt;b&gt;業者と金額のすり合わせは TEL で完了している&lt;/b&gt;（相見積・業者選定は発生しない）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="-292" width="1290" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="laneA" value="現行Fix（felix_total）　実行予算画面" style="swimlane;html=1;startSize=48;fontSize=15;fontStyle=1;fillColor=#FFF4E5;strokeColor=#D79B00;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="-230" width="380" height="2140" as="geometry"/>
                </mxCell>
                <mxCell id="A1" value="&lt;b&gt;&amp;nbsp;実行予算をつくる&lt;/b&gt;&lt;br&gt;【建設部担当者】&lt;br&gt;・実行予算を作成&lt;br&gt;・見積依頼ファイルをドライブに格納" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneA" vertex="1">
                    <mxGeometry x="40" y="80" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="A2" value="&lt;b&gt;項目追加（もらい発生時、追加した項目に対しはらいもらいを追加）&lt;/b&gt;&lt;br&gt;【建設部担当者】&lt;br&gt;・現行Fixで項目を追加する&lt;br&gt;　→ 新Fixの見積依頼画面に反映される" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneA" vertex="1">
                    <mxGeometry x="40" y="225" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="Anote" value="&lt;i&gt;※ もらい／はらいの判定は invoice_flg。&lt;br&gt;　 現行の業者追加ページでも、もらいの業者は追加できる。&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D79B00;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#7A5C00;" parent="laneA" vertex="1">
                    <mxGeometry x="40" y="350" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="laneC" value="業者マイページ（felix_total）" style="swimlane;html=1;startSize=48;fontSize=15;fontStyle=1;fillColor=#E8F5E9;strokeColor=#82B366;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1750" y="-230" width="470" height="2140" as="geometry"/>
                </mxCell>
                <mxCell id="C5" value="&lt;b&gt;⑤見積内容を確認する&lt;/b&gt;&lt;br&gt;【業者】業者マイページ見積タブのURLを開いてもらう。&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;FELIX担当者が入力した金額を確認。&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneC" vertex="1">
                    <mxGeometry x="50" y="500" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="C6" value="&lt;b&gt;⑥「発注承諾」ボタンを押す　⭐️新規機能&lt;/b&gt;&lt;br&gt;【業者】業者マイページ 見積タブ&lt;br&gt;・見積金額がOKなら承諾する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fontStyle=0" parent="laneC" vertex="1">
                    <mxGeometry x="50" y="800" width="300" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="C9" value="&lt;b&gt;⑨ 発注書プレビューに「承認済」のハンコ&lt;/b&gt;&lt;br&gt;【システム】業者マイページ 発注タブ&lt;br&gt;・発注書プレビューに承認済のハンコが押された状態になる&lt;br&gt;・以降、業者からの操作ボタンは出ない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneC" vertex="1">
                    <mxGeometry x="50" y="1260" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="C13" value="&lt;b&gt;発注後の取消処理&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;【要検討】&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;一次リリースでは含めない&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;dashed=1;" parent="laneC" vertex="1">
                    <mxGeometry x="50" y="1550" width="300" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="※発注後の取消は業者から部長宛に、業者マイページから申請するが、一次リリースではその機能は含めない。&lt;br&gt;もし、依頼が来たらデータメンテで対応。&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;発注承認後に、取消依頼が来た場合、&lt;div&gt;見積・発注・請求の金額は全てイコールになる。&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="laneC" vertex="1">
                    <mxGeometry x="25" y="1440" width="350" height="81" as="geometry"/>
                </mxCell>
