        <mxCell id="e8" value="発注書を発行 → 業者へ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="P3" target="V2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
