<mxfile host="app.diagrams.net" agent="new_felix_total" version="24.7.17" type="device">
  <diagram id="payable-flow" name="【支払】処理フロー">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2480" pageHeight="3902" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="【支払】処理フロー ― 画面 / 操作 / 対象テーブル・CRUD ―　※2026-09-02 時点の実装ベース" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="24" width="1500" height="34" as="geometry"/></mxCell>
        <mxCell id="pre" value="【前提】支払（はらい）＝ FELIX が業者へ支払う側。業者へ相見積を依頼し、選定・部長承認を経て発注する。新Fix の管理対象は&lt;b&gt;建設明細（estimate_units.step=2 かつ sub_cate=2）&lt;/b&gt;のみで、現行で作成した実行予算がその場で同期される（既存データの一括移行は行わない）。もらい／はらいの判定は現行 &lt;b&gt;estimate_unit_companies.invoice_flg&lt;/b&gt;（OFF＝支払）。" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="66" width="1700" height="74" as="geometry"/></mxCell>
        <mxCell id="lane_L1" value="現行Fix（felix_total）&lt;br&gt;実行予算画面" style="swimlane;html=1;horizontal=1;startSize=56;fontSize=14;fontStyle=1;whiteSpace=wrap;rounded=0;swimlaneFillColor=#f5f5f5;fillColor=#f5f5f5;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="400" height="798" as="geometry"/></mxCell>
        <mxCell id="lane_L2" value="新Fix&lt;br&gt;見積管理【支払】" style="swimlane;html=1;horizontal=1;startSize=56;fontSize=14;fontStyle=1;whiteSpace=wrap;rounded=0;swimlaneFillColor=#eaf2fb;fillColor=#eaf2fb;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="150" width="460" height="2816" as="geometry"/></mxCell>
        <mxCell id="lane_L3" value="業者マイページ&lt;br&gt;（felix_total）" style="swimlane;html=1;horizontal=1;startSize=56;fontSize=14;fontStyle=1;whiteSpace=wrap;rounded=0;swimlaneFillColor=#eaf5ea;fillColor=#eaf5ea;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="900" y="150" width="440" height="2467" as="geometry"/></mxCell>
        <mxCell id="lane_L4" value="新Fix&lt;br&gt;発注・納品管理" style="swimlane;html=1;horizontal=1;startSize=56;fontSize=14;fontStyle=1;whiteSpace=wrap;rounded=0;swimlaneFillColor=#f2ecf8;fillColor=#f2ecf8;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1340" y="150" width="400" height="3702" as="geometry"/></mxCell>
        <mxCell id="A1" value="&lt;b&gt;実行予算をつくる【建設部担当者】&lt;/b&gt;&lt;br&gt;・実行予算と項目（費用）を作成&lt;br&gt;・現行の保存時に新テーブルへ同期（NewQuotationRegisterService）&lt;br&gt;・対象は建設明細（step=2 かつ sub_cate=2）のみ&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;C/U &lt;b&gt;t_buildings&lt;/b&gt;（source_id = estimates.id）&lt;br&gt;C/U &lt;b&gt;t_building_budget_items&lt;/b&gt;（source_id = estimate_units.id）&lt;br&gt;R estimates / estimate_units（現行）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_L1"><mxGeometry x="40" y="80" width="340" height="211" as="geometry"/></mxCell>
        <mxCell id="A2" value="&lt;b&gt;項目追加（明細のクイック追加）【建設部担当者】&lt;/b&gt;&lt;br&gt;・もらい／はらいが発生したら現行で項目を足す&lt;br&gt;・追加した項目は新Fix の一覧にすぐ出る&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;C estimate_units（現行）&lt;br&gt;C &lt;b&gt;t_building_budget_items&lt;/b&gt;（source_id = estimate_units.id）&lt;br&gt;C/U &lt;b&gt;t_payable_partners&lt;/b&gt;（追加項目に紐づく見積先も同期）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_L1"><mxGeometry x="40" y="361" width="340" height="194" as="geometry"/></mxCell>
        <mxCell id="A3" value="&lt;b&gt;use_flg のチェックを外す【建設部担当者】&lt;/b&gt;&lt;br&gt;・按分グループはまとめて反映される&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;U estimate_units.use_flg（現行）&lt;br&gt;U &lt;b&gt;t_building_budget_items.is_enabled&lt;/b&gt; = false&lt;br&gt;R 新Fix の全画面・全条件で一覧・バッヂから除外" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_L1"><mxGeometry x="40" y="625" width="340" height="143" as="geometry"/></mxCell>
        <mxCell id="P0" value="&lt;b&gt;業者追加【建設部担当者】新Fix 見積依頼画面&lt;/b&gt;&lt;br&gt;・一覧の「業者追加」から現行の見積業者追加画面を &lt;b&gt;iframe&lt;/b&gt; で開く&lt;br&gt;・「請求先にする」&lt;b&gt;OFF&lt;/b&gt;＝はらい（新Fix から開いた画面では変更できない）&lt;br&gt;・保存は現行側で行われ、そのまま新テーブルへ同期される&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;C estimate_unit_companies（現行・iframe のフォーム）&lt;br&gt;C/U &lt;b&gt;t_payable_partners&lt;/b&gt;（source_id = estimate_unit_companies.id）&lt;br&gt;U/D t_billing_partners（区分を切り替えたら反対側を論理削除／復活）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_L2"><mxGeometry x="40" y="625" width="400" height="245" as="geometry"/></mxCell>
        <mxCell id="P1" value="&lt;b&gt;①【支払】見積依頼【建設部担当者】&lt;/b&gt;&lt;br&gt;・チェック → 送信で現行の order_estimate を呼ぶ&lt;br&gt;・業者へ&lt;b&gt;見積依頼メール&lt;/b&gt;を送信&lt;br&gt;・approval_status は変えない（DRAFT のまま）&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;R t_payable_partners / t_building_budget_items（一覧）&lt;br&gt;C estimate_order_histories（現行）&lt;br&gt;C/U &lt;b&gt;t_payable_quotation_requests&lt;/b&gt;（依頼回数・最終依頼日時）&lt;br&gt;C company_tokens（業者マイページのトークン）&lt;br&gt;C &lt;b&gt;mail_queues&lt;/b&gt;（別DB・見積依頼メール）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_L2"><mxGeometry x="40" y="940" width="400" height="211" as="geometry"/></mxCell>
        <mxCell id="V1" value="&lt;b&gt;見積を回答する【業者】見積タブ&lt;/b&gt;&lt;br&gt;・メールのリンクから開き、相見積の金額を入力&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;C/U estimate_unit_company_files（type=1）&lt;br&gt;C/U cost_unit_estimate_units&lt;br&gt;C/U/D &lt;b&gt;t_payable_quotations / t_payable_quotation_details&lt;/b&gt;（is_latest を再計算）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_L3"><mxGeometry x="40" y="1221" width="380" height="160" as="geometry"/></mxCell>
        <mxCell id="P2" value="&lt;b&gt;②【支払】業者選定【建設部担当者】&lt;/b&gt;&lt;br&gt;・業者の回答額を見て選定を確定&lt;br&gt;・新テーブル更新 → 現行 API の順で1トランザクション&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;R t_payable_quotations（相見積の金額）&lt;br&gt;U &lt;b&gt;t_payable_partners.approval_status&lt;/b&gt;（DRAFT → APPLIED）&lt;br&gt;U estimate_unit_companies.adoption_flg / estimate_units（現行 API）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_L2"><mxGeometry x="40" y="1451" width="400" height="177" as="geometry"/></mxCell>
        <mxCell id="P3" value="&lt;b&gt;③【支払】部長承認【松井部長】&lt;/b&gt;&lt;br&gt;・&lt;b&gt;承認&lt;/b&gt;：APPLIED → APPROVED。発注書を発行して業者マイページに出す&lt;br&gt;・&lt;b&gt;否認&lt;/b&gt;：APPLIED → DRAFT（業者選定へ差し戻し）&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;U &lt;b&gt;t_payable_partners.approval_status&lt;/b&gt;&lt;br&gt;C &lt;b&gt;t_payable_orders&lt;/b&gt; ＋ &lt;b&gt;t_payable_order_details&lt;/b&gt;（承認時に発行）&lt;br&gt;D t_payable_orders ＋ 明細（否認時に取消）&lt;br&gt;U estimate_units.tmp_company_id / company_select_status（現行 API）&lt;br&gt;C t_comments（否認理由「【否認】{理由}」）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_L2"><mxGeometry x="40" y="1698" width="400" height="245" as="geometry"/></mxCell>
        <mxCell id="V2" value="&lt;b&gt;発注書タブ【業者】&lt;/b&gt;&lt;br&gt;・弊社書式を印刷 → 社印を押した PDF を添付、発注日を入力&lt;br&gt;・&lt;b&gt;このタブに請負承認ボタンは無い&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;R estimate_customs / estimate_custom_units（プレビュー。無ければ print() が生成）&lt;br&gt;C/U estimate_unit_company_files（type=2 / file_cate=998）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_L3"><mxGeometry x="40" y="1698" width="380" height="194" as="geometry"/></mxCell>
        <mxCell id="P4" value="&lt;b&gt;④【支払】部長取消申請【建設部担当者】&lt;/b&gt;&lt;br&gt;・対象は APPROVED &lt;b&gt;かつ業者が請負承認していない&lt;/b&gt;もの&lt;br&gt;・業者へ「発注取消のご連絡」メールを送る&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;R t_payable_orders.contract_approved_at（承諾済みは対象外）&lt;br&gt;U &lt;b&gt;t_payable_partners.approval_status&lt;/b&gt;（APPROVED → CANCEL_APPLIED）&lt;br&gt;C t_comments（「【取消申請】{理由}」）&lt;br&gt;C &lt;b&gt;mail_queues&lt;/b&gt;（発注取消のご連絡）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_L2"><mxGeometry x="40" y="2013" width="400" height="211" as="geometry"/></mxCell>
        <mxCell id="V3" value="&lt;b&gt;請負承認する【業者】発注書画面 /order/{id}&lt;/b&gt;&lt;br&gt;・「請負承認」ボタンを押す＝&lt;b&gt;承諾&lt;/b&gt;&lt;br&gt;・発注書は③で発行済みなので、ここでは作らない&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;U orders.adoption_flg / adoption_date（現行）&lt;br&gt;U &lt;b&gt;t_payable_orders.contract_approved_at&lt;/b&gt;（未設定のときだけ入れる）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_L3"><mxGeometry x="40" y="2013" width="380" height="160" as="geometry"/></mxCell>
        <mxCell id="O1" value="&lt;b&gt;発注実行【建設部担当者】&lt;/b&gt;&lt;br&gt;・&lt;b&gt;〔サイドメニューに出していない画面〕&lt;/b&gt;　ルート・画面は存在する&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;C &lt;b&gt;t_orders&lt;/b&gt;（order_status = STAFF_APPROVED）&lt;br&gt;C t_order_approval_actions&lt;br&gt;R t_payable_quotations（金額）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontColor=#3d3d3d;" vertex="1" parent="lane_L4"><mxGeometry x="40" y="2013" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="P5" value="&lt;b&gt;⑤【支払】部長取消承認【松井部長】&lt;/b&gt;&lt;br&gt;・&lt;b&gt;取消承認&lt;/b&gt;：CANCEL_APPLIED → CANCELLED&lt;br&gt;・&lt;b&gt;取消否認&lt;/b&gt;：→ APPROVED 据え置き&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;U &lt;b&gt;t_payable_partners.approval_status&lt;/b&gt;&lt;br&gt;D &lt;b&gt;t_payable_orders&lt;/b&gt; ＋ 明細（取消承認時）&lt;br&gt;U estimate_units / estimate_unit_companies（建設部選定 → 採用 の順で解除）&lt;br&gt;C t_comments（「【取消承認】/【否認】{理由}」）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_L2"><mxGeometry x="40" y="2294" width="400" height="194" as="geometry"/></mxCell>
        <mxCell id="V4" value="&lt;b&gt;取消申請中はキャンセル表示【システム】&lt;/b&gt;&lt;br&gt;・発注書に「キャンセル」のマスク&lt;br&gt;・請負承認ボタンを出さない&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;R t_payable_partners.approval_status（CANCEL_APPLIED / CANCELLED）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_L3"><mxGeometry x="40" y="2294" width="380" height="143" as="geometry"/></mxCell>
        <mxCell id="O2" value="&lt;b&gt;発注承認【松井部長】&lt;/b&gt;&lt;br&gt;・&lt;b&gt;〔サイドメニューに出していない画面〕&lt;/b&gt;　ルート・画面は存在する&lt;br&gt;・発注書は③で発行済みのため、ここでは触らない&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;U &lt;b&gt;t_orders.order_status&lt;/b&gt;（→ APPROVED）&lt;br&gt;C t_order_approval_actions" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontColor=#3d3d3d;" vertex="1" parent="lane_L4"><mxGeometry x="40" y="2294" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="P6" value="&lt;b&gt;取消承認済（CANCELLED）＝業者選定へ差し戻し&lt;/b&gt;&lt;br&gt;・&lt;b&gt;行き止まりにしない。&lt;/b&gt;【支払】業者選定の操作対象に含める&lt;br&gt;・現行側の採用・建設部選定は外れており「回答あり・未選定」に戻っている&lt;br&gt;・相見積（t_payable_quotations）は残るので&lt;b&gt;見積依頼のやり直しは不要&lt;/b&gt;&lt;br&gt;・金額から見直したい場合は見積依頼でも再依頼できる（「未依頼のみ表示」を外すと出る）&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;R t_payable_partners（approval_status = CANCELLED）&lt;br&gt;R t_payable_quotations（相見積は残っている）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_L2"><mxGeometry x="40" y="2558" width="400" height="228" as="geometry"/></mxCell>
        <mxCell id="O3" value="&lt;b&gt;業者承諾確認【松井部長】&lt;/b&gt;&lt;br&gt;・発注書が発行済みのものを一覧表示&lt;br&gt;・承諾済／未承諾は contract_approved_at で判定&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;R &lt;b&gt;t_payable_orders&lt;/b&gt;（issued_at / subtotal_amount / contract_approved_at）&lt;br&gt;R t_payable_order_details" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_L4"><mxGeometry x="40" y="2558" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="OC" value="&lt;b&gt;発注取消申請 / 発注取消承認&lt;/b&gt;&lt;br&gt;・&lt;b&gt;〔サイドメニューに出していない画面〕&lt;/b&gt;　独立メニューを置かず、業者承諾確認画面のボタンから行う&lt;br&gt;・取消承認すると発注が消え、見積先は「発注実行待ち」へ戻る&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;U &lt;b&gt;t_orders.order_status&lt;/b&gt;（取消申請 → 取消承認）&lt;br&gt;D &lt;b&gt;t_orders&lt;/b&gt;（取消承認時）&lt;br&gt;C t_order_approval_actions&lt;br&gt;R t_payable_orders（発注書は消さない）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#eeeeee;strokeColor=#666666;dashed=1;fontColor=#3d3d3d;" vertex="1" parent="lane_L4"><mxGeometry x="40" y="2856" width="340" height="211" as="geometry"/></mxCell>
        <mxCell id="O4" value="&lt;b&gt;完了確認【建設部担当者】&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;C &lt;b&gt;t_delivery_reports&lt;/b&gt;（report_status = STAFF_APPROVED）&lt;br&gt;C &lt;b&gt;t_invoices&lt;/b&gt;（invoice_status = STAFF_APPROVED）&lt;br&gt;C t_delivery_report_approval_actions / t_invoice_approval_actions" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_L4"><mxGeometry x="40" y="3137" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="O5" value="&lt;b&gt;部長完了承認【松井部長】&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;U &lt;b&gt;t_delivery_reports.report_status&lt;/b&gt;（→ APPROVED）&lt;br&gt;C t_delivery_report_approval_actions" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_L4"><mxGeometry x="40" y="3367" width="340" height="126" as="geometry"/></mxCell>
        <mxCell id="O6" value="&lt;b&gt;請求取消承認【松井部長】&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;D &lt;b&gt;t_invoices&lt;/b&gt;（論理削除）&lt;br&gt;C t_invoice_approval_actions" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_L4"><mxGeometry x="40" y="3563" width="340" height="109" as="geometry"/></mxCell>
        <mxCell id="lg" value="凡例：&lt;font color=&#x27;#6c8ebf&#x27;&gt;■&lt;/font&gt; 建設部担当者　&lt;font color=&#x27;#d79b00&#x27;&gt;■&lt;/font&gt; 松井部長　&lt;font color=&#x27;#82b366&#x27;&gt;■&lt;/font&gt; 業者　&lt;font color=&#x27;#9673a6&#x27;&gt;■&lt;/font&gt; システム" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1840" y="66" width="560" height="36" as="geometry"/></mxCell>
        <mxCell id="st" value="&lt;b&gt;承認ステータス（t_payable_partners.approval_status）&lt;/b&gt;&lt;br&gt;DRAFT（未申請） → APPLIED（選定済・承認待ち） → APPROVED（部長承認済）&lt;br&gt;　→ CANCEL_APPLIED（取消申請中） → CANCELLED（取消承認済）&lt;br&gt;・&lt;b&gt;CANCELLED は終点ではない&lt;/b&gt;。業者選定へ差し戻して選び直せる&lt;br&gt;・部長承認の&lt;b&gt;否認&lt;/b&gt;は APPLIED → DRAFT（業者選定へ差し戻し）&lt;br&gt;・取消&lt;b&gt;否認&lt;/b&gt;は CANCEL_APPLIED → APPROVED（据え置き）&lt;br&gt;・否認理由の専用列は無く、t_comments の「【否認】」が唯一の記録" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="110" width="560" height="124" as="geometry"/></mxCell>
        <mxCell id="nm" value="&lt;b&gt;サイドメニューに出していない画面&lt;/b&gt;　&lt;font color=&#x27;#666666&#x27;&gt;■&lt;/font&gt; 灰色・破線の枠で表す。ルートと画面は存在するが、サイドメニューには並べていない（発注実行・発注承認・発注取消申請・発注取消承認）。" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#eeeeee;strokeColor=#666666;dashed=1;align=left;fontColor=#3d3d3d;" vertex="1" parent="1"><mxGeometry x="1840" y="242" width="560" height="76" as="geometry"/></mxCell>
        <mxCell id="n0" value="&lt;b&gt;CRUD の凡例&lt;/b&gt;　C=登録 / R=参照 / U=更新 / D=削除（論理削除を含む）&lt;br&gt;太字は&lt;b&gt;新スキーマ（t_*）&lt;/b&gt;。それ以外は現行 felix_total のテーブル。&lt;br&gt;mail_queues は別DB（itplus4_list）。" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="334" width="560" height="80" as="geometry"/></mxCell>
        <mxCell id="n1" value="&lt;b&gt;新テーブル → 現行API の順で書く&lt;/b&gt;&lt;br&gt;選定・承認・取消承認は「新テーブルを先に更新 → 現行 felix_total の API を呼ぶ」を1トランザクションで行い、現行側が失敗したら新テーブルもロールバックする。" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="434" width="560" height="96" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;サイドメニューのバッヂ&lt;/b&gt;&lt;br&gt;見積依頼＝未依頼件数／業者選定・部長承認・取消申請・取消承認＝未処理件数。&lt;br&gt;発注系の画面はバッヂを出さない。無効項目（is_enabled=false）は件数からも除く。" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="550" width="560" height="96" as="geometry"/></mxCell>
        <mxCell id="n3" value="取消申請できるのは&lt;b&gt;「部長承認 → 業者の請負承認で発注が確定」までの間&lt;/b&gt;だけ。承諾済みは一覧に出さず、実行時にも弾く。" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="666" width="560" height="76" as="geometry"/></mxCell>
        <mxCell id="n4" value="発注の&lt;b&gt;否認・取消では発注書（t_payable_orders）を消さない&lt;/b&gt;。発注書は見積承認（③）の成果物として扱うため。消すのは部長承認の否認と部長取消承認のときだけ。" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="762" width="560" height="86" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;業者への通知メール&lt;/b&gt;&lt;br&gt;その場では送らず、別DB（itplus4_list）の mail_queues へ status=0 / send_time=現在＋10分（JST）で予約登録する。配信は既存のバッチが行う。" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="868" width="560" height="96" as="geometry"/></mxCell>
        <mxCell id="todo" value="&lt;b&gt;未決事項（実装はブロックしていない）&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;承認ステータスの語彙&lt;/b&gt;… 旧図の UNSELECTED / STAFF_APPROVED / CANCEL_APPROVED は実装に無い。本図は実装に合わせている（§D-1）&lt;br&gt;2. &lt;b&gt;見積依頼履歴の数え方&lt;/b&gt;… estimate_order_histories は解約通知などでも作られ、依頼回数が多く出る場合がある（§D-3）&lt;br&gt;3. &lt;b&gt;否認理由の記録先&lt;/b&gt;… 専用列が無く t_comments の「【否認】」が唯一の記録。コメントは項目単位（§D-6）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="984" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="ref" value="&lt;b&gt;関連ドキュメント&lt;/b&gt;&lt;br&gt;・docs/detailed-design/支払系_必要処理一覧.md&lt;br&gt;・docs/detailed-design/quotations/01〜05、orders/01&lt;br&gt;・請求（もらい）側 … 本ファイルの「【請求】処理フロー」シート" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="1154" width="560" height="96" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A1" target="A2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A2" target="A3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2b" value="項目データ（もらい／はらいの器）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="A2" target="P0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="434" y="561"/><mxPoint x="434" y="740"/><mxPoint x="680" y="740"/></Array></mxGeometry></mxCell>
