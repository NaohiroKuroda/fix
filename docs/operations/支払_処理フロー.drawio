                </mxCell>
                <mxCell id="laneB" value="新Fix（new_felix_total）　見積管理【支払】" style="swimlane;html=1;startSize=48;fontSize=15;fontStyle=1;fillColor=#E3F2FD;strokeColor=#6C8EBF;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="480" y="-230" width="540" height="1150" as="geometry"/>
                </mxCell>
                <mxCell id="P1" value="&lt;b&gt;①【支払】見積依頼【FELIX→業者依頼前】&lt;/b&gt;&lt;br&gt;【建設部担当者】&lt;br&gt;&lt;b&gt;業者追加：&lt;/b&gt;&lt;br&gt;・支払取引先(t_payable_partners)に登録&lt;br&gt;&lt;b&gt;見積依頼（チェック→送信）：&lt;/b&gt;&lt;br&gt;・支払見積依頼履歴(t_payable_quotation_requests)に登録&lt;br&gt;・支払取引先(t_payable_partners)の承認ステータスを更新&lt;br&gt;・業者に見積依頼メールを送信" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneB" vertex="1">
                    <mxGeometry x="60" y="80" width="400" height="175" as="geometry"/>
                </mxCell>
                <mxCell id="P2" value="&lt;b&gt;②【支払】業者選定【業者→FELIX返答済】&lt;/b&gt;&lt;br&gt;【建設部担当者】&lt;br&gt;&lt;b&gt;選定：&lt;/b&gt;&lt;br&gt;・業者が選定され、選定承認（部長承認）に表示&lt;br&gt;・支払取引先(t_payable_partners)の承認ステータスを更新&lt;br&gt;　UNSELECTED → STAFF_APPROVED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneB" vertex="1">
                    <mxGeometry x="60" y="290" width="400" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="P3" value="&lt;b&gt;③【支払】部長承認【業者選定済→FELIX(建設部)】&lt;/b&gt;&lt;br&gt;【松井部長】&lt;br&gt;&lt;b&gt;承認：&lt;/b&gt;&lt;br&gt;・発注書を作成し、業者マイページに表示&lt;br&gt;・支払発注(t_payable_orders)に登録　※テーブル未作成&lt;br&gt;・承認ステータスを更新　STAFF_APPROVED → APPROVED&lt;br&gt;&lt;b&gt;否認：&lt;/b&gt;&lt;br&gt;・選定が解除される（業者選定へ差し戻し）&lt;br&gt;・承認ステータスを更新　→ UNSELECTED&lt;br&gt;・コメント(t_comments)に登録" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneB" vertex="1">
                    <mxGeometry x="60" y="455" width="400" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="P4" value="&lt;b&gt;④【支払】部長取消申請【FELIX(担当者)→FELIX(建設部部長)】&lt;/b&gt;&lt;br&gt;【建設部担当者】&lt;br&gt;&lt;b&gt;取消申請：&lt;/b&gt;&lt;br&gt;・承認ステータスを更新　APPROVED → CANCEL_APPLIED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneB" vertex="1">
                    <mxGeometry x="60" y="690" width="400" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="P5" value="&lt;b&gt;⑤【支払】部長取消承認【FELIX(建設部部長)→FELIX(担当者)】&lt;/b&gt;&lt;br&gt;【松井部長】&lt;br&gt;&lt;b&gt;取消承認：&lt;/b&gt;&lt;br&gt;・承認ステータスを更新　CANCEL_APPLIED → CANCEL_APPROVED&lt;br&gt;&lt;b&gt;取消否認：&lt;/b&gt;&lt;br&gt;・承認ステータスを更新&lt;br&gt;・コメント(t_comments)に登録　※未実装" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneB" vertex="1">
