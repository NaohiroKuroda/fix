        <mxCell id="e5" value="見積依頼メール" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="P1" target="V1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="1336"/><mxPoint x="1130" y="1336"/></Array></mxGeometry></mxCell>
        <mxCell id="e6" value="業者の見積回答（相見積）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="V1" target="P2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="1566"/><mxPoint x="680" y="1566"/></Array></mxGeometry></mxCell>
