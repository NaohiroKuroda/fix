                <mxCell id="eA3" value="業者追加（もらい）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" parent="1" source="A2" target="B1" edge="1">
                    <mxGeometry relative="1" as="geometry" />
