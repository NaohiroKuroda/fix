# =========================================================
# 開発用イメージ（Windows / Mac, Docker Desktop）
#   PHP 8.3 CLI + Node 22 + Composer
#   ソースはコンテナにマウントし、依存はコンテナ内で導入する。
# =========================================================
FROM php:8.3-cli

# gd / exif は添付画像の圧縮・サムネ生成（06_添付ファイル_詳細設計 §5）に必要。
RUN apt-get update && apt-get install -y --no-install-recommends \
        git unzip libzip-dev libicu-dev libonig-dev curl ca-certificates gnupg \
        libpng-dev libjpeg62-turbo-dev libwebp-dev libfreetype6-dev \
    && docker-php-ext-configure gd --with-jpeg --with-webp --with-freetype \
    && docker-php-ext-install pdo_mysql zip intl gd exif \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# アップロード上限等（06_添付ファイル_詳細設計 §11）。conf.d に置き php ビルトインサーバにも効かせる。
COPY .docker/php/uploads.ini /usr/local/etc/php/conf.d/zz-uploads.ini

WORKDIR /var/www/html

COPY .docker/dev-entrypoint.sh /usr/local/bin/dev-entrypoint
RUN chmod +x /usr/local/bin/dev-entrypoint

# 8000 = php artisan serve / 5173 = Vite dev server
EXPOSE 8000 5173

ENTRYPOINT ["dev-entrypoint"]
