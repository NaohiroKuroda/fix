    <diagram id="payable-flow" name="支払 処理フロー">
        <mxGraphModel dx="1809" dy="2587" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1700" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="【支払】処理フロー　― 画面 / 操作 / データ更新先 ―" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="-332" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="pre" value="&lt;b&gt;【前提】&lt;/b&gt;　支払（はらい）＝ FELIX が業者へ支払う側のフロー。業者へ相見積を依頼し、選定・部長承認を経て発注する。　見積先は 2026-08 のスキーマ改訂で &lt;b&gt;t_payable_partners&lt;/b&gt;（支払）に分離された。　請求（もらい）側は もらい_運用フロー.drawio を参照。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="-292" width="1400" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="legendTitle" value="凡例（誰が操作するか）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="960" y="-326" width="200" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="lg1" value="建設部担当者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="-330" width="90" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="lg2" value="松井部長" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1186" y="-330" width="80" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="lg3" value="業者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1272" y="-330" width="70" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="lg4" value="システム" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1348" y="-330" width="92" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="laneA" value="現行Fix（felix_total）　実行予算画面" style="swimlane;html=1;startSize=48;fontSize=15;fontStyle=1;fillColor=#FFF4E5;strokeColor=#D79B00;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="-230" width="430" height="1150" as="geometry"/>
                </mxCell>
                <mxCell id="A1" value="&lt;b&gt;　実行予算をつくる&lt;/b&gt;&lt;br&gt;【建設部担当者】&lt;br&gt;・実行予算と項目（費用）を作成&lt;br&gt;・見積依頼ファイルをドライブに格納" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneA" vertex="1">
                    <mxGeometry x="40" y="95" width="300" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="A2" value="&lt;b&gt;　業者追加（iframe）&lt;/b&gt;&lt;br&gt;【建設部担当者】&lt;br&gt;・新Fixの一覧から iframe で開く&lt;br&gt;・「請求先にする」&lt;b&gt;OFF ＝ はらい（支払）&lt;/b&gt;　←本フロー&lt;br&gt;・ON ＝ もらい（請求）→ もらい_運用フロー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneA" vertex="1">
                    <mxGeometry x="40" y="200" width="300" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="Anote" value="※ もらい／はらいの判定は現行 invoice_flg。&lt;br&gt;　 新スキーマではテーブルごと分離される：&lt;br&gt;　 支払 → t_payable_partners（本フロー）&lt;br&gt;　 請求 → t_billing_partners" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D79B00;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#7A5C00;" parent="laneA" vertex="1">
                    <mxGeometry x="40" y="560" width="300" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="&lt;b&gt;　業者確認（iframe）&lt;/b&gt;&lt;div&gt;見るだけ&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="laneA">
                    <mxGeometry x="40" y="330" width="300" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="業者確認" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=1;exitY=0.5;entryX=-0.01;entryY=0.843;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="laneA" target="P1">
