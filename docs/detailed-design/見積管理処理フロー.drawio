        <mxCell id="e12" value="申請" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="P4" target="P5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e13" value="取消承認" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="P5" target="P6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e14" value="キャンセル表示＋通知メール" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="P4" target="V4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="2409"/><mxPoint x="1130" y="2409"/></Array></mxGeometry></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="O1" target="O2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="O2" target="O3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e17" value="取消する場合" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="O3" target="OC"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e17b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="O3" target="O4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1550" y="2971"/><mxPoint x="1360" y="2971"/><mxPoint x="1360" y="3252"/><mxPoint x="1550" y="3252"/></Array></mxGeometry></mxCell>
        <mxCell id="e17c" value="取消承認 → 発注実行待ちへ戻る" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="OC" target="O1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1348" y="3056"/><mxPoint x="1348" y="2213"/></Array></mxGeometry></mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="O4" target="O5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="O5" target="O6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e20" value="承諾日（contract_approved_at）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="V3" target="O3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1790" y="2213"/><mxPoint x="1790" y="2758"/></Array></mxGeometry></mxCell>
        <mxCell id="e23" value="業者選定へ差し戻し（選び直す）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="P6" target="P2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="436" y="2748"/><mxPoint x="436" y="1641"/></Array></mxGeometry></mxCell>
        <mxCell id="e21" value="否認 → 業者選定へ差し戻し" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="P3" target="P2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="464" y="1898"/><mxPoint x="464" y="1651"/></Array></mxGeometry></mxCell>
        <mxCell id="e22" value="取消否認 → APPROVED 据え置き" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jumpStyle=arc;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="P5" target="P3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="2504"/><mxPoint x="450" y="1918"/></Array></mxGeometry></mxCell>
