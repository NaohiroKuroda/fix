# =========================================================
# 開発用イメージ（Windows / Mac, Docker Desktop）
#   PHP 8.4 CLI + Node 22 + Composer
#   ソースはコンテナにマウントし、依存はコンテナ内で導入する。
# =========================================================
FROM php:8.4-cli

RUN apt-get update && apt-get install -y --no-install-recommends \
        git unzip libzip-dev libicu-dev libonig-dev curl ca-certificates gnupg \
    && docker-php-ext-install pdo_mysql zip intl \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY .docker/dev-entrypoint.sh /usr/local/bin/dev-entrypoint
RUN chmod +x /usr/local/bin/dev-entrypoint

# 8000 = php artisan serve / 5173 = Vite dev server
EXPOSE 8000 5173

ENTRYPOINT ["dev-entrypoint"]
