  <diagram id="billing-flow" name="【請求】処理フロー">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2480" pageHeight="3110" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="【請求】処理フロー ― 画面 / 操作 / 対象テーブル・CRUD ―　※2026-09-02 時点の実装ベース" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="24" width="1500" height="34" as="geometry"/></mxCell>
        <mxCell id="pre" value="【前提】請求（もらい）＝ FELIX が業者へ請求する側。&lt;b&gt;業者と金額のすり合わせは TEL で完了済み&lt;/b&gt;で始まるため、相見積・業者選定は発生しない。画面とデータの向きははらいと同じ &lt;b&gt;FELIX → 業者&lt;/b&gt; に揃え、&lt;b&gt;見積も発注も FELIX 側で自作自演で登録&lt;/b&gt;する。業者は「確認して承諾する」だけ。もらい／はらいの判定は現行 &lt;b&gt;estimate_unit_companies.invoice_flg&lt;/b&gt;（ON＝請求）。" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="66" width="1700" height="74" as="geometry"/></mxCell>
        <mxCell id="lane_L1" value="現行Fix（felix_total）&lt;br&gt;実行予算画面" style="swimlane;html=1;horizontal=1;startSize=56;fontSize=14;fontStyle=1;whiteSpace=wrap;rounded=0;swimlaneFillColor=#f5f5f5;fillColor=#f5f5f5;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="400" height="764" as="geometry"/></mxCell>
        <mxCell id="lane_L2" value="新Fix&lt;br&gt;見積管理【請求】" style="swimlane;html=1;horizontal=1;startSize=56;fontSize=14;fontStyle=1;whiteSpace=wrap;rounded=0;swimlaneFillColor=#eaf2fb;fillColor=#eaf2fb;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="150" width="460" height="2910" as="geometry"/></mxCell>
        <mxCell id="lane_L3" value="業者マイページ&lt;br&gt;（felix_total）" style="swimlane;html=1;horizontal=1;startSize=56;fontSize=14;fontStyle=1;whiteSpace=wrap;rounded=0;swimlaneFillColor=#eaf5ea;fillColor=#eaf5ea;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="900" y="150" width="440" height="2646" as="geometry"/></mxCell>
        <mxCell id="lane_L4" value="新Fix&lt;br&gt;【請求】発注書確認" style="swimlane;html=1;horizontal=1;startSize=56;fontSize=14;fontStyle=1;whiteSpace=wrap;rounded=0;swimlaneFillColor=#f2ecf8;fillColor=#f2ecf8;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1340" y="150" width="400" height="2237" as="geometry"/></mxCell>
        <mxCell id="A1" value="&lt;b&gt;実行予算をつくる【建設部担当者】&lt;/b&gt;&lt;br&gt;・実行予算と項目（費用）を作成&lt;br&gt;・現行の保存時に新テーブルへ同期&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;C/U &lt;b&gt;t_buildings&lt;/b&gt;（source_id = estimates.id）&lt;br&gt;C/U &lt;b&gt;t_building_budget_items&lt;/b&gt;（source_id = estimate_units.id）&lt;br&gt;R estimates / estimate_units（現行）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_L1"><mxGeometry x="40" y="80" width="340" height="177" as="geometry"/></mxCell>
        <mxCell id="A2" value="&lt;b&gt;項目追加（明細のクイック追加）【建設部担当者】&lt;/b&gt;&lt;br&gt;・もらいが発生したら現行で項目を足す&lt;br&gt;・追加した項目は新Fix の一覧にすぐ出る&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;C estimate_units（現行）&lt;br&gt;C &lt;b&gt;t_building_budget_items&lt;/b&gt;（source_id = estimate_units.id）&lt;br&gt;C/U &lt;b&gt;t_billing_partners&lt;/b&gt;（追加項目に紐づく取引先も同期）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_L1"><mxGeometry x="40" y="327" width="340" height="194" as="geometry"/></mxCell>
        <mxCell id="A3" value="&lt;b&gt;use_flg のチェックを外す【建設部担当者】&lt;/b&gt;&lt;br&gt;・按分グループはまとめて反映される&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;U estimate_units.use_flg（現行）&lt;br&gt;U &lt;b&gt;t_building_budget_items.is_enabled&lt;/b&gt; = false&lt;br&gt;R 新Fix の全画面・全条件で一覧・バッヂから除外" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_L1"><mxGeometry x="40" y="591" width="340" height="143" as="geometry"/></mxCell>
        <mxCell id="B0" value="&lt;b&gt;② 業者追加【建設部担当者】新Fix【請求】見積作成画面&lt;/b&gt;&lt;br&gt;・一覧の「業者追加」から現行の見積業者追加画面を &lt;b&gt;iframe&lt;/b&gt; で開く&lt;br&gt;・「請求先にする」&lt;b&gt;ON&lt;/b&gt;＝もらい（新Fix から開いた画面では変更できない）&lt;br&gt;・保存は現行側で行われ、そのまま新テーブルへ同期される&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;C estimate_unit_companies（現行・iframe のフォーム）&lt;br&gt;C/U &lt;b&gt;t_billing_partners&lt;/b&gt;（source_id = estimate_unit_companies.id）&lt;br&gt;U/D t_payable_partners（区分を切り替えたら反対側を論理削除／復活）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_L2"><mxGeometry x="40" y="591" width="400" height="245" as="geometry"/></mxCell>
        <mxCell id="B1" value="&lt;b&gt;①②③【請求】見積作成【建設部担当者】&lt;/b&gt;&lt;br&gt;・実行予算のデータを取り込んで一覧表示&lt;br&gt;・モーダルで見積額・明細を入力して保存（版管理）&lt;br&gt;・保存と同時に承認申請&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;R t_buildings / t_building_budget_items / t_billing_partners&lt;br&gt;C &lt;b&gt;t_billing_quotations&lt;/b&gt; ＋ &lt;b&gt;t_billing_quotation_details&lt;/b&gt;（新しい版）&lt;br&gt;U t_billing_quotations.is_latest（既存の版を落とす）&lt;br&gt;U &lt;b&gt;t_billing_partners.approval_status&lt;/b&gt;（DRAFT/CANCELLED → APPLIED）&lt;br&gt;C t_attachments（見積書ファイルの添付）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_L2"><mxGeometry x="40" y="906" width="400" height="262" as="geometry"/></mxCell>
        <mxCell id="B2" value="&lt;b&gt;④【請求】見積承認【松井部長】&lt;/b&gt;&lt;br&gt;・&lt;b&gt;承認&lt;/b&gt;：APPLIED → APPROVED。業者へ通知して現行へ同期&lt;br&gt;・&lt;b&gt;否認&lt;/b&gt;：→ CANCELLED（見積作成へ差し戻し）&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;U &lt;b&gt;t_billing_partners.approval_status&lt;/b&gt;&lt;br&gt;C &lt;b&gt;mail_queues&lt;/b&gt;（見積確認・発注承諾のご依頼）&lt;br&gt;C/U estimate_unit_company_files（type=1）＋ cost_unit_estimate_units&lt;br&gt;C estimate_unit_company_files（type=2 / file_cate=998。発注書タブ用）&lt;br&gt;D estimate_customs / estimate_custom_units（帳票キャッシュを捨てて作り直す）&lt;br&gt;C t_comments（否認理由「【否認】{理由}」）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_L2"><mxGeometry x="40" y="1238" width="400" height="262" as="geometry"/></mxCell>
        <mxCell id="V1" value="&lt;b&gt;⑤ 見積内容を確認する【業者】見積タブ&lt;/b&gt;&lt;br&gt;・通知メールのリンクから開く&lt;br&gt;・FELIX が入力した金額を確認&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;R estimate_unit_company_files（type=1）／ cost_unit_estimate_units&lt;br&gt;R estimate_customs / estimate_custom_units（見積書プレビュー）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_L3"><mxGeometry x="40" y="1570" width="380" height="177" as="geometry"/></mxCell>
        <mxCell id="V2" value="&lt;b&gt;⑥「発注承諾する」を押す【業者】見積タブ&lt;/b&gt;&lt;br&gt;・承諾と同時に&lt;b&gt;⑧ 発注書を発行&lt;/b&gt;する&lt;br&gt;・業者へ「発注確定のお知らせ」メール&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;U &lt;b&gt;t_billing_quotations.accepted_at&lt;/b&gt;（業者承諾日時）&lt;br&gt;C &lt;b&gt;t_billing_orders&lt;/b&gt; ＋ &lt;b&gt;t_billing_order_details&lt;/b&gt;&lt;br&gt;U t_billing_orders.contract_approved_at（承諾と同じ日時）&lt;br&gt;C &lt;b&gt;mail_queues&lt;/b&gt;（発注確定のお知らせ）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_L3"><mxGeometry x="40" y="1817" width="380" height="194" as="geometry"/></mxCell>
        <mxCell id="D1" value="&lt;b&gt;⑧【請求】発注書確認【松井部長】&lt;/b&gt;&lt;br&gt;・発注書が発行済み（＝承諾済み）のものを一覧表示&lt;br&gt;・発注書ボタン＝業者と同じ帳票を iframe 表示&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;R &lt;b&gt;t_billing_orders&lt;/b&gt;（subtotal_amount / contract_approved_at）&lt;br&gt;R t_billing_order_details / t_billing_partners&lt;br&gt;R estimate_customs / estimate_custom_units（帳票）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_L4"><mxGeometry x="40" y="1817" width="340" height="194" as="geometry"/></mxCell>
        <mxCell id="V3" value="&lt;b&gt;⑨ 発注書タブ【システム】&lt;/b&gt;&lt;br&gt;・発注書プレビューに「{日付} 承認済」のハンコ&lt;br&gt;・以降、業者からの操作ボタンは出さない&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;R &lt;b&gt;t_billing_orders.contract_approved_at&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_L3"><mxGeometry x="40" y="2081" width="380" height="126" as="geometry"/></mxCell>
        <mxCell id="D2" value="&lt;b&gt;⑨ 請求予定データを作成【システム】&lt;/b&gt;&lt;br&gt;・既存テーブル or 新テーブル&lt;br&gt;・※北川さんとすり合わせ（未着手）&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;C 未定" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_L4"><mxGeometry x="40" y="2081" width="340" height="126" as="geometry"/></mxCell>
        <mxCell id="B3" value="&lt;b&gt;【請求】見積取消申請【建設部担当者】&lt;/b&gt;&lt;br&gt;・対象は APPROVED &lt;b&gt;かつ業者が承諾していない&lt;/b&gt;もの&lt;br&gt;・業者へ「発注取消のご連絡」メール&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;R t_billing_quotations.accepted_at（承諾済みは対象外）&lt;br&gt;U &lt;b&gt;t_billing_partners.approval_status&lt;/b&gt;（APPROVED → CANCEL_APPLIED）&lt;br&gt;C t_comments（「【取消申請】{理由}」）&lt;br&gt;C &lt;b&gt;mail_queues&lt;/b&gt;（発注取消のご連絡）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_L2"><mxGeometry x="40" y="2277" width="400" height="194" as="geometry"/></mxCell>
        <mxCell id="V4" value="&lt;b&gt;取消申請中はキャンセル表示【システム】&lt;/b&gt;&lt;br&gt;・見積書・発注書に「キャンセル」のマスク&lt;br&gt;・発注承諾ボタンを出さない&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;R t_billing_partners.approval_status（CANCEL_APPLIED / CANCELLED）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_L3"><mxGeometry x="40" y="2277" width="380" height="143" as="geometry"/></mxCell>
        <mxCell id="B4" value="&lt;b&gt;【請求】見積取消承認【松井部長】&lt;/b&gt;&lt;br&gt;・&lt;b&gt;取消承認&lt;/b&gt;：→ CANCELLED（見積作成へ差し戻し）&lt;br&gt;・&lt;b&gt;取消否認&lt;/b&gt;：→ APPROVED 据え置き&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;U &lt;b&gt;t_billing_partners.approval_status&lt;/b&gt;&lt;br&gt;D &lt;b&gt;t_billing_orders&lt;/b&gt; ＋ 明細（発行済みなら取消）&lt;br&gt;C t_comments（「【取消承認】/【否認】{理由}」）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_L2"><mxGeometry x="40" y="2541" width="400" height="160" as="geometry"/></mxCell>
        <mxCell id="V5" value="&lt;b&gt;発注後の取消申請（業者 → 部長）&lt;/b&gt;&lt;br&gt;・一次リリースでは含めない&lt;br&gt;・依頼が来たらデータメンテで対応" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_L3"><mxGeometry x="40" y="2541" width="380" height="75" as="geometry"/></mxCell>
        <mxCell id="B5" value="&lt;b&gt;業者選定画面（表示のみ）&lt;/b&gt;&lt;br&gt;・もらいは選定不要。ボタンは非活性&lt;br&gt;&lt;br&gt;&lt;b&gt;― 対象テーブル / CRUD ―&lt;/b&gt;&lt;br&gt;R t_billing_partners（操作不可）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_L2"><mxGeometry x="40" y="2771" width="400" height="109" as="geometry"/></mxCell>
        <mxCell id="lg" value="凡例：&lt;font color=&#x27;#6c8ebf&#x27;&gt;■&lt;/font&gt; 建設部担当者　&lt;font color=&#x27;#d79b00&#x27;&gt;■&lt;/font&gt; 松井部長　&lt;font color=&#x27;#82b366&#x27;&gt;■&lt;/font&gt; 業者　&lt;font color=&#x27;#9673a6&#x27;&gt;■&lt;/font&gt; システム" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1840" y="66" width="560" height="36" as="geometry"/></mxCell>
        <mxCell id="st" value="&lt;b&gt;承認ステータス（t_billing_partners.approval_status）&lt;/b&gt;&lt;br&gt;DRAFT（未申請） → APPLIED（承認申請中） → APPROVED（承認済）&lt;br&gt;　→ CANCEL_APPLIED（取消申請中） → CANCELLED（取消承認済＝見積作成へ差し戻し）&lt;br&gt;・見積承認の&lt;b&gt;否認&lt;/b&gt;は APPLIED → CANCELLED（見積作成へ差し戻し）&lt;br&gt;・取消&lt;b&gt;否認&lt;/b&gt;は CANCEL_APPLIED → APPROVED（据え置き）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="110" width="560" height="110" as="geometry"/></mxCell>
        <mxCell id="n0" value="&lt;b&gt;CRUD の凡例&lt;/b&gt;　C=登録 / R=参照 / U=更新 / D=削除（論理削除を含む）&lt;br&gt;太字は&lt;b&gt;新スキーマ（t_*）&lt;/b&gt;。それ以外は現行 felix_total のテーブル。&lt;br&gt;mail_queues は別DB（itplus4_list）。" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="240" width="560" height="80" as="geometry"/></mxCell>
        <mxCell id="n1" value="&lt;b&gt;もらい(Fix) の向き&lt;/b&gt;&lt;br&gt;本来のもらいは業者が発注者だが、Fix では画面・データの向きをはらいと同じ &lt;b&gt;FELIX → 業者&lt;/b&gt; に揃え、見積も発注も FELIX 側で自作自演で登録する。そのため「業者から見積が返ってくる」ステップは発生しない。" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="340" width="560" height="106" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;サイドメニューのバッヂ&lt;/b&gt;&lt;br&gt;見積作成・見積承認・見積取消申請・見積取消承認＝未処理件数。&lt;br&gt;【請求】発注書確認はバッヂを出さない。無効項目（is_enabled=false）は件数からも除く。" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="466" width="560" height="96" as="geometry"/></mxCell>
        <mxCell id="n3" value="取消申請できるのは&lt;b&gt;業者が承諾する前&lt;/b&gt;だけ。そのため承諾済みが取り消される流れは発生せず、承諾日・ハンコの巻き戻しは不要。" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="582" width="560" height="76" as="geometry"/></mxCell>
        <mxCell id="n4" value="見積作成へ戻ったら金額・明細を編集して再度承認申請できる。再承認すると業者へ通知メールが飛び、キャンセル表示も解除される。" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="678" width="560" height="76" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;業者への通知メール&lt;/b&gt;&lt;br&gt;その場では送らず、別DB（itplus4_list）の mail_queues へ status=0 / send_time=現在＋10分（JST）で予約登録する。&lt;br&gt;④・取消申請は&lt;b&gt;新Fix&lt;/b&gt; から、⑧ は契機が業者の承諾なので&lt;b&gt;現行Fix&lt;/b&gt; から送る。" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="774" width="560" height="106" as="geometry"/></mxCell>
        <mxCell id="todo" value="&lt;b&gt;未決事項（実装はブロックしていない）&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;もらい用の送信履歴の置き場&lt;/b&gt;… 既存 send_required_file_histories に種別を足すか、新テーブルにするか（§D-9）&lt;br&gt;2. &lt;b&gt;通知メールの再送手段&lt;/b&gt;… 画面に再送ボタンを置くか、データメンテで対応するか（§D-8）&lt;br&gt;3. &lt;b&gt;取消否認時に業者へ取り下げを連絡するか&lt;/b&gt;… 取消申請時に「キャンセルします」と伝えたままになる（§D-10）&lt;br&gt;4. &lt;b&gt;通知メールの文面・宛先&lt;/b&gt;… 依頼文の言い回しと、宛先を現行の pic_mail と同じ優先順位でよいか（§D-6a）&lt;br&gt;5. &lt;b&gt;⑨ 請求予定データ&lt;/b&gt;… 作成先のテーブルが未定（北川さんとすり合わせ）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="900" width="560" height="170" as="geometry"/></mxCell>
        <mxCell id="ref" value="&lt;b&gt;関連ドキュメント&lt;/b&gt;&lt;br&gt;・docs/detailed-design/請求系_必要処理一覧.md&lt;br&gt;・docs/detailed-design/quotations/06〜09、orders/02&lt;br&gt;・支払（はらい）側 … 本ファイルの「【支払】処理フロー」シート" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="1090" width="560" height="96" as="geometry"/></mxCell>
