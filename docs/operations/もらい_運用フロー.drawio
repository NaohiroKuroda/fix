                <mxCell id="B1" value="&lt;b&gt;① 【請求】見積作成画面にデータが表示される&lt;/b&gt;&lt;br&gt;【システム】&lt;br&gt;・実行予算のデータを取り込んで一覧表示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneB" vertex="1">
                    <mxGeometry x="418" y="80" width="320" height="90" as="geometry"/>
