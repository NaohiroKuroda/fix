                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="B7" value="&lt;b&gt;⑦ 業者選定画面（表示のみ）&lt;/b&gt;&lt;br&gt;【建設部担当者】新Fix&lt;br&gt;・もらいは&lt;b&gt;選定不要&lt;/b&gt;。業者選定列のボタンは&lt;b&gt;非活性&lt;/b&gt;&lt;br&gt;・標準単価／予算単価／仮選定列は「-」&lt;br&gt;・相見積列はマイページ入力額を表示&lt;br&gt;・「請求先にする」は変更できない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneB" vertex="1">
