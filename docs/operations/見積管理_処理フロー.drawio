<mxfile host="65bd71144e">
    <diagram id="quotation-flow" name="見積管理 処理フロー">
        <mxGraphModel dx="1772" dy="3277" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1900" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="title" value="見積管理 処理フロー　― 画面 / 操作 / データ更新先 ―" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="-332" width="1000" height="30" as="geometry" />
                </mxCell>
                <mxCell id="pre" value="&lt;b&gt;【前提】&lt;/b&gt;　見積管理は【支払】＝はらい（FELIX が業者へ支払う）と【請求】＝もらい（FELIX が業者へ請求する）の 2 系統。2026-08 のスキーマ改訂で見積先は 支払＝t_payable_partners / 請求＝t_billing_partners に分割された。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="-292" width="1960" height="40" as="geometry" />
                </mxCell>
                <mxCell id="legendTitle" value="凡例（誰が操作するか）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1520" y="-326" width="200" height="24" as="geometry" />
                </mxCell>
                <mxCell id="lg1" value="建設部担当者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1650" y="-330" width="90" height="28" as="geometry" />
                </mxCell>
                <mxCell id="lg2" value="松井部長" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1746" y="-330" width="80" height="28" as="geometry" />
                </mxCell>
                <mxCell id="lg3" value="業者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1832" y="-330" width="70" height="28" as="geometry" />
                </mxCell>
                <mxCell id="lg4" value="システム" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1908" y="-330" width="80" height="28" as="geometry" />
                </mxCell>
                <mxCell id="laneA" value="現行Fix（felix_total）　実行予算画面" style="swimlane;html=1;startSize=48;fontSize=15;fontStyle=1;fillColor=#FFF4E5;strokeColor=#D79B00;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="-230" width="380" height="1290" as="geometry" />
                </mxCell>
                <mxCell id="laneB" value="新Fix（new_felix_total）　見積管理" style="swimlane;html=1;startSize=48;fontSize=15;fontStyle=1;fillColor=#E3F2FD;strokeColor=#6C8EBF;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="440" y="-230" width="1120" height="1290" as="geometry" />
                </mxCell>
                <mxCell id="laneC" value="業者マイページ（felix_total）" style="swimlane;html=1;startSize=48;fontSize=15;fontStyle=1;fillColor=#E8F5E9;strokeColor=#82B366;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1580" y="-230" width="420" height="1290" as="geometry" />
                </mxCell>
                <mxCell id="A1" value="&lt;b&gt;　実行予算をつくる&lt;/b&gt;&lt;br&gt;【建設部担当者】&lt;br&gt;・実行予算と項目（費用）を作成&lt;br&gt;・見積依頼ファイルをドライブに格納" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneA" vertex="1">
                    <mxGeometry x="40" y="95" width="300" height="95" as="geometry" />
                </mxCell>
                <mxCell id="A2" value="&lt;b&gt;　業者追加（iframe）&lt;/b&gt;&lt;br&gt;【建設部担当者】&lt;br&gt;・新Fixの一覧から iframe で開く&lt;br&gt;・「請求先にする」ON ＝ もらい（請求）&lt;br&gt;・OFF ＝ はらい（支払）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneA" vertex="1">
                    <mxGeometry x="40" y="240" width="300" height="115" as="geometry" />
                </mxCell>
                <mxCell id="Anote" value="※ もらい／はらいの判定は現行 invoice_flg。&lt;br&gt;　 新スキーマではテーブルごと分離される：&lt;br&gt;　 支払 → t_payable_partners&lt;br&gt;　 請求 → t_billing_partners" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D79B00;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#7A5C00;" parent="laneA" vertex="1">
                    <mxGeometry x="40" y="400" width="300" height="95" as="geometry" />
                </mxCell>
                <mxCell id="secPay" value="【支払】はらい　FELIX → 業者へ支払う" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" parent="laneB" vertex="1">
                    <mxGeometry x="40" y="60" width="380" height="26" as="geometry" />
                </mxCell>
                <mxCell id="P1" value="&lt;b&gt;①【支払】見積依頼【FELIX→業者依頼前】&lt;/b&gt;&lt;br&gt;【建設部担当者】&lt;br&gt;&lt;b&gt;業者追加：&lt;/b&gt;&lt;br&gt;・支払取引先(t_payable_partners)に登録&lt;br&gt;&lt;b&gt;見積依頼（チェック→送信）：&lt;/b&gt;&lt;br&gt;・支払見積依頼履歴(t_payable_quotation_requests)に登録&lt;br&gt;・支払取引先(t_payable_partners)の承認ステータスを更新&lt;br&gt;・業者に見積依頼メールを送信" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneB" vertex="1">
                    <mxGeometry x="40" y="95" width="380" height="175" as="geometry" />
                </mxCell>
                <mxCell id="P2" value="&lt;b&gt;②【支払】業者選定【業者→FELIX返答済】&lt;/b&gt;&lt;br&gt;【建設部担当者】&lt;br&gt;&lt;b&gt;選定：&lt;/b&gt;&lt;br&gt;・業者が選定され、選定承認（部長承認）に表示&lt;br&gt;・支払取引先(t_payable_partners)の承認ステータスを更新&lt;br&gt;　UNSELECTED → STAFF_APPROVED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneB" vertex="1">
                    <mxGeometry x="40" y="300" width="380" height="130" as="geometry" />
                </mxCell>
                <mxCell id="P3" value="&lt;b&gt;③【支払】部長承認【業者選定済→FELIX(建設部)】&lt;/b&gt;&lt;br&gt;【松井部長】&lt;br&gt;&lt;b&gt;承認：&lt;/b&gt;&lt;br&gt;・発注書を作成し、業者マイページに表示&lt;br&gt;・支払発注(t_payable_orders)に登録　※テーブル未作成&lt;br&gt;・承認ステータスを更新　STAFF_APPROVED → APPROVED&lt;br&gt;&lt;b&gt;否認：&lt;/b&gt;&lt;br&gt;・選定が解除される（業者選定へ差し戻し）&lt;br&gt;・承認ステータスを更新　→ UNSELECTED&lt;br&gt;・コメント(t_comments)に登録" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneB" vertex="1">
                    <mxGeometry x="40" y="460" width="380" height="200" as="geometry" />
                </mxCell>
                <mxCell id="P4" value="&lt;b&gt;④【支払】部長取消申請【FELIX(担当者)→FELIX(建設部部長)】&lt;/b&gt;&lt;br&gt;【建設部担当者】&lt;br&gt;&lt;b&gt;取消申請：&lt;/b&gt;&lt;br&gt;・承認ステータスを更新　APPROVED → CANCEL_APPLIED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneB" vertex="1">
                    <mxGeometry x="40" y="690" width="380" height="110" as="geometry" />
                </mxCell>
                <mxCell id="P5" value="&lt;b&gt;⑤【支払】部長取消承認【FELIX(建設部部長)→FELIX(担当者)】&lt;/b&gt;&lt;br&gt;【松井部長】&lt;br&gt;&lt;b&gt;取消承認：&lt;/b&gt;&lt;br&gt;・承認ステータスを更新　CANCEL_APPLIED → CANCEL_APPROVED&lt;br&gt;&lt;b&gt;取消否認：&lt;/b&gt;&lt;br&gt;・承認ステータスを更新&lt;br&gt;・コメント(t_comments)に登録　※未実装" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneB" vertex="1">
                    <mxGeometry x="40" y="830" width="380" height="155" as="geometry" />
                </mxCell>
                <mxCell id="P6" value="完了（CANCEL_APPROVED）　以降どの画面にも出ない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" parent="laneB" vertex="1">
                    <mxGeometry x="40" y="1030" width="380" height="45" as="geometry" />
                </mxCell>
                <mxCell id="secBill" value="【請求】もらい　FELIX → 業者へ請求する" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" parent="laneB" vertex="1">
                    <mxGeometry x="650" y="60" width="400" height="26" as="geometry" />
                </mxCell>
                <mxCell id="B1" value="&lt;b&gt;①【請求】見積作成【FELIX(担当者)→業者】&lt;/b&gt;&lt;br&gt;【建設部担当者】&lt;br&gt;&lt;b&gt;業者追加：&lt;/b&gt;&lt;br&gt;・請求取引先(t_billing_partners)に登録&lt;br&gt;&lt;b&gt;見積作成：&lt;/b&gt;&lt;br&gt;・請求見積(t_billing_quotations)と&lt;br&gt;　請求見積明細(t_billing_quotation_details)に登録&lt;br&gt;&lt;b&gt;見積修正：&lt;/b&gt;&lt;br&gt;・請求見積明細に登録か更新？　※未決&lt;br&gt;&lt;b&gt;承認申請：&lt;/b&gt;&lt;br&gt;・編集をロックして承認申請（「見積承認」画面に表示）&lt;br&gt;・請求取引先(t_billing_partners)の承認ステータスを更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneB" vertex="1">
                    <mxGeometry x="650" y="95" width="400" height="215" as="geometry" />
                </mxCell>
                <mxCell id="B2" value="&lt;b&gt;②【請求】見積承認【FELIX(建設部部長)→業者】&lt;/b&gt;&lt;br&gt;【松井部長】&lt;br&gt;&lt;b&gt;承認：&lt;/b&gt;&lt;br&gt;・業者マイページに見積書を表示し、通知（確認依頼）メールを送信&lt;br&gt;・請求取引先(t_billing_partners)の承認ステータスを更新&lt;br&gt;・発注のテーブルに登録　※テーブル未決&lt;br&gt;&lt;b&gt;否認：&lt;/b&gt;&lt;br&gt;・差し戻し（「見積作成」画面に表示）&lt;br&gt;・承認ステータスを更新　・コメント(t_comments)に登録" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneB" vertex="1">
                    <mxGeometry x="650" y="340" width="400" height="185" as="geometry" />
                </mxCell>
                <mxCell id="B3" value="&lt;b&gt;③【請求】見積取消申請【FELIX(担当者)→FELIX(建設部部長)】&lt;/b&gt;&lt;br&gt;【建設部担当者】&lt;br&gt;&lt;b&gt;取消申請：&lt;/b&gt;&lt;br&gt;・請求取引先(t_billing_partners)の承認ステータスを更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneB" vertex="1">
                    <mxGeometry x="650" y="555" width="400" height="110" as="geometry" />
                </mxCell>
                <mxCell id="B4" value="&lt;b&gt;④【請求】見積取消承認【FELIX(建設部部長)→FELIX(担当者)】&lt;/b&gt;&lt;br&gt;【松井部長】&lt;br&gt;&lt;b&gt;取消承認：&lt;/b&gt;&lt;br&gt;・請求取引先(t_billing_partners)の承認ステータスを更新&lt;br&gt;&lt;b&gt;取消否認：&lt;/b&gt;&lt;br&gt;・承認ステータスを更新&lt;br&gt;・コメント(t_comments)に登録　※未実装" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneB" vertex="1">
                    <mxGeometry x="650" y="695" width="400" height="155" as="geometry" />
                </mxCell>
                <mxCell id="C1" value="&lt;b&gt;　見積を回答する&lt;/b&gt;&lt;br&gt;【業者】業者マイページ 見積タブ&lt;br&gt;・見積依頼メールのリンクから開く&lt;br&gt;・相見積の金額を入力 → 新Fixの業者選定に表示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneC" vertex="1">
                    <mxGeometry x="40" y="180" width="340" height="110" as="geometry" />
                </mxCell>
                <mxCell id="C2" value="&lt;b&gt;　発注書を確認する&lt;/b&gt;&lt;br&gt;【業者】業者マイページ 発注タブ&lt;br&gt;・部長承認で作成された発注書を確認" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneC" vertex="1">
                    <mxGeometry x="40" y="480" width="340" height="90" as="geometry" />
                </mxCell>
                <mxCell id="C3" value="&lt;b&gt;　見積書を確認する（もらい）&lt;/b&gt;&lt;br&gt;【業者】業者マイページ 見積タブ&lt;br&gt;・FELIX が作成した見積書を確認&lt;br&gt;・以降の「発注承諾」は もらい_運用フロー を参照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="laneC" vertex="1">
                    <mxGeometry x="40" y="640" width="340" height="110" as="geometry" />
                </mxCell>
