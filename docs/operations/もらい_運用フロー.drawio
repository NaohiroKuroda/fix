                        <mxPoint x="331" y="700" as="sourcePoint"/>
                        <mxPoint x="120" y="772" as="targetPoint"/>
                        <Array as="points">
                            <mxPoint x="200" y="800"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="13" value="このタイミングで、担当者から修正依頼をして欲しい場合に、部長取消申請" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="laneC" vertex="1">
                    <mxGeometry x="210" y="660" width="240" height="80" as="geometry"/>
