                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="eDenyB" value="否認 → 見積作成へ差し戻し" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=1;exitY=0.5;entryX=1;entryY=0.5;dashed=1;strokeColor=#B85450;fontColor=#B85450;" parent="laneB" source="B2" target="B1" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="eB4back" value="取消承認 → 見積作成からやり直し" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=0;exitY=0.5;entryX=0;entryY=0.5;dashed=1;strokeColor=#B85450;fontColor=#B85450;" parent="laneB" source="B4" target="B1" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="stTitle" value="承認ステータス（approval_status）の遷移" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1120" width="700" height="28" as="geometry" />
                </mxCell>
                <mxCell id="stBox" value="&lt;b&gt;支払（t_payable_partners）&lt;/b&gt;&lt;br&gt;UNSELECTED　─見積依頼→　UNSELECTED　─選定→　STAFF_APPROVED&lt;br&gt;　─部長承認→　APPROVED　─取消申請→　CANCEL_APPLIED　─取消承認→　CANCEL_APPROVED&lt;br&gt;　（部長承認の否認は UNSELECTED へ戻す）&lt;br&gt;&lt;br&gt;&lt;b&gt;請求（t_billing_partners）&lt;/b&gt;&lt;br&gt;UNSELECTED　─承認申請→　STAFF_APPROVED　─見積承認→　APPROVED&lt;br&gt;　─取消申請→　CANCEL_APPLIED　─取消承認→　CANCEL_APPROVED&lt;br&gt;　（見積承認の否認・取消承認はいずれも見積作成へ差し戻す）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1160" width="940" height="200" as="geometry" />
                </mxCell>
                <mxCell id="todoTitle" value="未実装・未決事項" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="1120" width="700" height="28" as="geometry" />
                </mxCell>
                <mxCell id="todoBox" value="1. &lt;b&gt;支払発注 t_payable_orders はテーブル未作成&lt;/b&gt;（部長承認での発注書作成・発注登録が未実装）&lt;br&gt;2. &lt;b&gt;請求側の発注テーブルが未決&lt;/b&gt;（見積承認時に登録する方針は確定済み）&lt;br&gt;3. &lt;b&gt;取消否認が支払・請求とも未実装&lt;/b&gt;（否認時に戻すステータスが未確定）&lt;br&gt;4. &lt;b&gt;【請求】見積修正&lt;/b&gt; は明細を登録（新しい版）か更新（上書き）か未決&lt;br&gt;5. &lt;b&gt;見積依頼の履歴登録が未実装&lt;/b&gt;（現行は felix_total の order_estimate を呼ぶのみ。&lt;br&gt;　 t_payable_quotation_requests へ書いていないため送信回数・最終依頼日時が 0 のまま）&lt;br&gt;6. 否認理由の専用列が新スキーマに無いため、&lt;b&gt;t_comments の「【否認】」投稿が唯一の記録&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="1160" width="980" height="200" as="geometry" />
                </mxCell>
                <mxCell id="refBox" value="&lt;b&gt;関連ドキュメント&lt;/b&gt;&lt;br&gt;・もらい（請求）の運用フロー詳細 … もらい_運用フロー.drawio&lt;br&gt;・画面ごとの詳細設計 … docs/detailed-design/quotations/01〜09&lt;br&gt;・旧→新スキーマの対応 … docs/architecture/backend.md §3.7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D79B00;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#7A5C00;" parent="1" vertex="1">
