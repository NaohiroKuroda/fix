                <mxCell id="dirTitle" value="&lt;b&gt;凡例：お金と書類の流れ（はらい / もらい(本来) / もらい(Fix)）&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="40" y="2230" width="900" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="dirHarai" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px&quot;&gt;はらい&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;見積依頼を出す&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B0004E&quot;&gt;FELIX&lt;/font&gt;　→　業者&lt;br&gt;&lt;br&gt;&lt;b&gt;見積が返ってくる&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B0004E&quot;&gt;FELIX&lt;/font&gt;　←　業者&lt;br&gt;&lt;br&gt;&lt;b&gt;発注&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B0004E&quot;&gt;FELIX&lt;/font&gt;　→　業者&lt;br&gt;&lt;br&gt;&lt;b&gt;請求&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B0004E&quot;&gt;FELIX&lt;/font&gt;　←　業者&lt;br&gt;&lt;br&gt;&lt;b&gt;支払い&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B0004E&quot;&gt;FELIX&lt;/font&gt;　→　業者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="40" y="2270" width="210" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="dirMoraiHonrai" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px&quot;&gt;もらい(本来)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;見積依頼を出す&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B0004E&quot;&gt;FELIX&lt;/font&gt;　←　業者&lt;br&gt;&lt;br&gt;&lt;b&gt;見積が返ってくる&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B0004E&quot;&gt;FELIX&lt;/font&gt;　→　業者&lt;br&gt;&lt;br&gt;&lt;b&gt;発注&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B0004E&quot;&gt;FELIX&lt;/font&gt;　←　業者&lt;br&gt;&lt;br&gt;&lt;b&gt;請求&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B0004E&quot;&gt;FELIX&lt;/font&gt;　→　業者&lt;br&gt;&lt;br&gt;&lt;b&gt;支払い&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B0004E&quot;&gt;FELIX&lt;/font&gt;　←　業者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="270" y="2270" width="210" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="dirMoraiFix" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px&quot;&gt;もらい(Fix)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;見積依頼を出す&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B0004E&quot;&gt;FELIX&lt;/font&gt;　→　業者&lt;br&gt;&lt;br&gt;&lt;b&gt;見積が返ってくる&lt;/b&gt;&lt;br&gt;&lt;s&gt;&lt;font color=&quot;#B0004E&quot;&gt;FELIX&lt;/font&gt;　←　業者&lt;/s&gt;　&lt;font color=&quot;#999999&quot;&gt;※発生しない&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;発注&lt;/b&gt;（自作自演）&lt;br&gt;&lt;font color=&quot;#B0004E&quot;&gt;FELIX&lt;/font&gt;　→　業者&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;←&lt;/span&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;請求&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B0004E&quot;&gt;FELIX&lt;/font&gt;　→　業者&lt;br&gt;&lt;br&gt;&lt;b&gt;支払い&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B0004E&quot;&gt;FELIX&lt;/font&gt;　←　業者&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="500" y="2270" width="250" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="dirNote" value="&lt;b&gt;もらい(本来) と もらい(Fix) の違い&lt;/b&gt;　… 本来のもらいは&lt;b&gt;業者が発注者&lt;/b&gt;で、見積依頼も発注も業者→FELIXの向き。&lt;br&gt;Fixでは画面・データの向きを&lt;b&gt;はらいと同じ（FELIX→業者）&lt;/b&gt;に揃え、見積依頼と発注をFELIX側で&lt;b&gt;自作自演&lt;/b&gt;で登録する。&lt;br&gt;そのため「業者から見積が返ってくる」ステップは発生せず（FELIX担当者が業者マイページで代理入力する）、&lt;b&gt;請求だけが FELIX → 業者&lt;/b&gt;（＝FELIXが請求する側）になる。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="2620" width="1320" height="90" as="geometry"/>
                </mxCell>
